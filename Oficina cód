CREATE TABLE clientes (
    id_cliente BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nome TEXT NOT NULL,
    telefone TEXT,
    email TEXT,
    cidade TEXT
);

CREATE TABLE veiculos (
    id_veiculo BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    id_cliente BIGINT NOT NULL,
    placa TEXT NOT NULL UNIQUE,
    marca TEXT NOT NULL,
    modelo TEXT NOT NULL,
    ano INTEGER NOT NULL,
    FOREIGN KEY (id_cliente) REFERENCES clientes(id_cliente)
);

CREATE TABLE mecanicos (
    id_mecanico BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nome TEXT NOT NULL,
    especialidade TEXT,
    telefone TEXT
);

CREATE TABLE servicos (
    id_servico BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nome_servico TEXT NOT NULL,
    descricao TEXT,
    valor_base NUMERIC(10,2) NOT NULL
);

CREATE TABLE ordens_servico (
    id_ordem BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    id_veiculo BIGINT NOT NULL,
    id_mecanico BIGINT NOT NULL,
    data_entrada DATE NOT NULL,
    data_saida DATE,
    status TEXT NOT NULL,
    FOREIGN KEY (id_veiculo) REFERENCES veiculos(id_veiculo),
    FOREIGN KEY (id_mecanico) REFERENCES mecanicos(id_mecanico)
);

CREATE TABLE itens_ordem_servico (
    id_item BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    id_ordem BIGINT NOT NULL,
    id_servico BIGINT NOT NULL,
    quantidade INTEGER NOT NULL,
    valor_unitario NUMERIC(10,2) NOT NULL,
    FOREIGN KEY (id_ordem) REFERENCES ordens_servico(id_ordem),
    FOREIGN KEY (id_servico) REFERENCES servicos(id_servico)
);


