SELECT nome, telefone, cidade
FROM clientes
ORDER BY nome;


SELECT marca, modelo, ano, placa
FROM veiculos
WHERE id_cliente = 1;


SELECT
    clientes.nome,
    veiculos.marca,
    veiculos.modelo,
    veiculos.placa
FROM clientes
INNER JOIN veiculos
ON clientes.id_cliente = veiculos.id_cliente
ORDER BY clientes.nome;


SELECT
    clientes.nome AS cliente,
    veiculos.marca,
    veiculos.modelo,
    mecanicos.nome AS mecanico,
    ordens_servico.data_entrada,
    ordens_servico.status
FROM ordens_servico
INNER JOIN veiculos
ON ordens_servico.id_veiculo = veiculos.id_veiculo
INNER JOIN clientes
ON veiculos.id_cliente = clientes.id_cliente
INNER JOIN mecanicos
ON ordens_servico.id_mecanico = mecanicos.id_mecanico
ORDER BY ordens_servico.data_entrada;


SELECT
    id_ordem,
    id_veiculo,
    data_entrada,
    status
FROM ordens_servico
WHERE status = 'Em andamento';


SELECT
    nome_servico,
    valor_base
FROM servicos
WHERE valor_base > 150
ORDER BY valor_base DESC;


SELECT
    id_ordem,
    SUM(quantidade * valor_unitario) AS valor_total
FROM itens_ordem_servico
GROUP BY id_ordem
ORDER BY valor_total DESC;
